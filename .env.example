# =============================================================================
# THE VA SCHOOL — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy to .env.local and fill in. .env.local is git-ignored; NEVER commit real
# values. The contract these satisfy is enforced by lib/env.ts, which fails at
# startup rather than at request time if anything is missing or malformed.
#
# Generate any secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Database -----------------------------------------------------------------
# MongoDB Atlas connection string.
MONGODB_URI=
#
# Database name within the cluster. REQUIRED — there is deliberately no default
# outside production.
#
#   LOCAL / DEVELOPMENT : va_school_test    <- use this
#   PRODUCTION (Vercel) : va_school
#
# This used to default to "va_school", the LIVE database. That default is how a
# destructive test helper once reached real records and permanently destroyed a
# family's enrollment application. lib/env.ts now REFUSES to use "va_school"
# unless NODE_ENV=production, so the safe path is the default path and the
# dangerous one has to be asked for by name (ALLOW_PRODUCTION_DB=1).
#
# `npm run dev:test` forces the test database regardless of what is set here.
MONGODB_DB=va_school_test

# --- Secrets ------------------------------------------------------------------
# Signs session JWTs. Minimum 32 characters of real entropy. Rotating this logs
# every user out, which is the intended behaviour after a suspected compromise.
SESSION_SECRET=
# Signs enrollment draft cookies and form-issue timestamps. Deliberately separate
# from SESSION_SECRET: a leak of this lower-value secret must not be able to mint
# an admin session.
#
# WATCH FOR TRAILING WHITESPACE. lib/env.ts trims this, but if the value differs
# between two environments (Preview vs Production) every form served by one and
# submitted to the other fails HMAC verification, and the family sees the generic
# "we could not process that submission" error. Log line: [anti-abuse] timestamp
# forged on enroll-step
FORM_HMAC_SECRET=

# Optional, and normally EMPTY. Set to the OLD form secret for the duration of a
# rotation, then remove it. Without it, rotating FORM_HMAC_SECRET invalidates every
# form already served AND every enrollment draft cookie at once, dumping families
# who are mid-agreement back to the start. Keep it set for longer than 12 hours
# (MAX_FORM_AGE_MS), then delete. Verification accepts it; signing never uses it.
FORM_HMAC_SECRET_PREVIOUS=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# Must be on a Resend-verified sending domain.
EMAIL_FROM=enrollment@fyht4.com
# Where new enrollment applications are announced.
SCHOOL_NOTIFICATION_EMAIL=teamvcorp@thevacorp.com

# --- Site ---------------------------------------------------------------------
# Absolute origin. Used for links in email, OG images, JSON-LD, and the
# Server Action allowed-origins CSRF check in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scheduled jobs -----------------------------------------------------------
# Shared secret protecting the email-retry route handler from public invocation.
CRON_SECRET=
