{
  "name": "homeschool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "db:init": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/db-init.ts",
    "db:ping": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/db-ping.ts",
    "seed:admin": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed-admin.ts",
    "check:email": "tsx --conditions=react-server scripts/check-school-email.ts",
    "e2e": "node scripts/e2e/run-all.mjs",
    "seed:test-fixtures": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed-test-fixtures.ts",
    "db:reset-test": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/reset-test-db.ts",
    "dev:test": "node -e \"process.env.MONGODB_DB='va_school_test';require('child_process').spawn(process.platform==='win32'?'npx.cmd':'npx',['next','dev'],{stdio:'inherit',env:process.env})\"",
    "check:agreement": "tsx --conditions=react-server scripts/check-agreement-hash.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@node-rs/argon2": "^2.0.2",
    "jose": "^6.2.8",
    "mongodb": "^6.21.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
