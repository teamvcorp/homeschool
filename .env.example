# =============================================================================
# THE VA SCHOOL — ENVIRONMENT TEMPLATE
# =============================================================================
# Copy to .env.local and fill in. .env.local is git-ignored; NEVER commit real
# values. The contract these satisfy is enforced by lib/env.ts, which fails at
# startup rather than at request time if anything is missing or malformed.
#
# Generate any secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- Database -----------------------------------------------------------------
# MongoDB Atlas connection string.
MONGODB_URI=
# Database name within the cluster.
MONGODB_DB=va_school

# --- Secrets ------------------------------------------------------------------
# Signs session JWTs. Minimum 32 characters of real entropy. Rotating this logs
# every user out, which is the intended behaviour after a suspected compromise.
SESSION_SECRET=
# Signs enrollment draft cookies and form-issue timestamps. Deliberately separate
# from SESSION_SECRET: a leak of this lower-value secret must not be able to mint
# an admin session.
FORM_HMAC_SECRET=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# Must be on a Resend-verified sending domain.
EMAIL_FROM=enrollment@fyht4.com
# Where new enrollment applications are announced.
SCHOOL_NOTIFICATION_EMAIL=teamvcorp@thevacorp.com

# --- Site ---------------------------------------------------------------------
# Absolute origin. Used for links in email, OG images, JSON-LD, and the
# Server Action allowed-origins CSRF check in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scheduled jobs -----------------------------------------------------------
# Shared secret protecting the email-retry route handler from public invocation.
CRON_SECRET=
